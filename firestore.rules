rules_version = '2';

// Security rules for the gift-quiz platform.
// - A project is publicly readable only once it is published; otherwise only
//   its owner can read it. Writes are always owner-only.
// - The `slugs` collection maps a public slug to its projectId so the runtime
//   can resolve /g/{slug} -> project. Slug claims require sign-in.
service cloud.firestore {
  match /databases/{database}/documents {

    match /projects/{projectId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerUid;
      }
      // A collaborator is anyone signed in whose email is on the project's
      // editorEmails allowlist (set by the owner). Gives full content access.
      function isCollaborator() {
        return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email in resource.data.get('editorEmails', []);
      }
      // Collaborators may edit content but must not change ownership or the
      // collaborator list — only the owner manages those.
      function keepsOwnershipFields() {
        return request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.get('editorEmails', []) == resource.data.get('editorEmails', []);
      }

      allow read: if resource.data.published == true || isOwner() || isCollaborator();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid;
      allow update: if isOwner() || (isCollaborator() && keepsOwnershipFields());
      allow delete: if isOwner();
    }

    match /slugs/{slug} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
