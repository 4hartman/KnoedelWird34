rules_version = '2';

// Uploaded images live under userImages/{uid}/**. Anyone can read them (they are
// embedded in published gifts), but only the owning, signed-in user may upload,
// and only reasonably sized image files.
service firebase.storage {
  match /b/{bucket}/o {
    match /userImages/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
